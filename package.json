{
  "name": "hastons",
  "version": "1.5.1",
  "type": "module",
  "scripts": {
    "generate:og": "node scripts/generate-og-images.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "pnpm generate:og && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src scripts",
    "lint:chat": "node scripts/check-chat-architecture.mjs",
    "verify:chat": "node scripts/verify-chat-ui.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset version && git add . && git commit -m 'chore: version bump'"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/react": "^7.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.10",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@shadcn/helpers": "^0.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/ai": "^1.0.0",
    "@tanstack/ai-react": "^1.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.1",
    "astro-embed": "^0.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "mixpanel": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@oxlint/plugins": "^1.89.0",
    "@resvg/resvg-js": "^2.6.2",
    "gray-matter": "^4.0.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "playwright": "^1.64.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "satori": "^0.63.2"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ],
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-tailwindcss",
      "prettier-plugin-astro-organize-imports"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.21.0"
}
